{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "agency-os": {
      "root": "artifacts/agency-os",
      "framework": "vite"
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/public/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "agency-os"
      }
    },
    {
      "source": "/templates/(.*)",
      "destination": {
        "service": "agency-os"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "agency-os"
      }
    }
  ]
}
