{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "agency-os": {
      "root": "artifacts/agency-os",
      "framework": "vite"
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(health|healthz)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/public/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "agency-os"
      }
    },
    {
      "source": "/templates/(.*)",
      "destination": {
        "service": "agency-os"
      }
    },
    {
      "source": "/js/(.*)",
      "destination": {
        "service": "agency-os"
      }
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|svg|ico|webp|json|txt|woff|woff2|ttf|eot|xlsx|pdf|xml|css|js|map))",
      "destination": {
        "service": "agency-os"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "agency-os",
        "path": "/index.html"
      }
    }
  ]
}
