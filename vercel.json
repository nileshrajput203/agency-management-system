{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "services": {
    "agency-os": {
      "root": "artifacts/agency-os",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "api-server",
          "format": "url",
          "env": "API_SERVER_URL"
        }
      ]
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/public/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/((?!api/|public/|assets/|templates/|.*\\..*$).*)",
      "destination": {
        "service": "agency-os",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "agency-os"
      }
    }
  ]
}
