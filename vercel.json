{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/agency-os/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/templates/(.*)",
      "destination": "/templates/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
