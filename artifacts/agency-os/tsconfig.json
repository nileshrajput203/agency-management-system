{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "src/app/**/*",
    "src/components/auth/login-form.tsx",
    "src/components/clients/client-detail-tabs.tsx",
    "src/components/clients/clients-manager.tsx",
    "src/proxy.ts",
    "src/components/automation/**/*",
    "src/components/client/**/*",
    "src/components/content/**/*",
    "src/components/sales/**/*",
    "src/components/settings/**/*",
    "src/components/tasks/**/*",
    "src/components/team/**/*",
    "src/lib/access.ts",
    "src/lib/auth.config.ts",
    "src/lib/actions/**/*",
    "src/lib/pdf-print.ts",
    "src/components/finance/**/*",
    "src/components/layout/app-sidebar.tsx",
    "src/components/layout/command-palette.tsx",
    "src/components/layout/notification-bell.tsx",
    "src/components/projects/contract-detail-view.tsx",
    "src/components/projects/contract-project-board.tsx",
    "src/components/projects/project-detail-view.tsx",
    "src/components/projects/projects-board.tsx",
    "src/components/projects/projects-manager.tsx",
    "src/components/providers.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
